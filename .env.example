# ============================================================
# Aurelia Hotel Management System — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.
# ============================================================

# --- General ---
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:3000
HOTEL_NAME=Aurelia Hotel
HOTEL_CURRENCY=FCFA
HOTEL_TIMEZONE=Africa/Douala
TAX_RATE_PERCENT=10
DEFAULT_DEPOSIT_PERCENT=40
NO_SHOW_CUTOFF_HOURS=6

# --- Firebase Admin SDK (server-side) ---
# Get these from Firebase Console > Project Settings > Service Accounts >
# Generate new private key. Paste the values from the downloaded JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and \n escapes exactly as in the JSON file.
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=

# --- MTN Mobile Money (Collections API) ---
# Register at https://momodeveloper.mtn.com — start in the sandbox
# environment, move to production once your merchant account is approved.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/webhooks/payment

# --- Orange Money (Web Payment API) ---
# Register at https://developer.orange.com — Orange Money Web Payment CM.
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_URL=https://your-domain.com/api/webhooks/payment

# --- Email notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATIONS_FROM_EMAIL=reservations@aureliahotel.com

# --- SMS (optional — leave SMS_PROVIDER blank to disable) ---
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
