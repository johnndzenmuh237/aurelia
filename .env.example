# --- MTN Mobile Money (Collections API) ---
# Register at https://momodeveloper.mtn.com — start in the sandbox
# environment, move to production once your merchant account is approved.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/webhooks/payment

# --- Orange Money (Web Payment API) ---
# Register at https://developer.orange.com — Orange Money Web Payment CM.
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_URL=https://your-domain.com/api/webhooks/payment

# --- Email notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATIONS_FROM_EMAIL=reservations@aureliahotel.com

# --- SMS (optional — leave SMS_PROVIDER blank to disable) ---
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
