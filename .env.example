# ============================================================
# Aurelia Hotel Management System — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.
# ============================================================

# --- General ---
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:3000
HOTEL_NAME=Aurelia Hotel
HOTEL_CURRENCY=FCFA
HOTEL_TIMEZONE=Africa/Douala
TAX_RATE_PERCENT=10
DEFAULT_DEPOSIT_PERCENT=40
NO_SHOW_CUTOFF_HOURS=6

<<<<<<< HEAD
# --- Staff login (no accounts, no Firebase Authentication) ---
# Every team shares ONE password, set here by the manager. Staff pick
# their team and type this password at /login.html — see docs/security.md.
# Use a long, random value for JWT_SECRET (e.g. `openssl rand -hex 32`) —
# it's what cryptographically signs staff login sessions.
JWT_SECRET=
SUPER_ADMIN_PASSWORD=
MANAGER_PASSWORD=
FRONT_DESK_PASSWORD=
RESERVATIONS_PASSWORD=
HOUSEKEEPING_PASSWORD=
MAINTENANCE_PASSWORD=
RESTAURANT_PASSWORD=
HR_PASSWORD=
ACCOUNTANT_PASSWORD=
EMPLOYEE_PASSWORD=

# --- Firebase Admin SDK (server-side — Firestore database only) ---
# Firebase Authentication and Firebase Storage are NOT used in this
# project — only Firestore, as the database. Get these three values from
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key, then paste them from the downloaded JSON file.
