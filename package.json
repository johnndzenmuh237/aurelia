{
  "name": "aurelia-hotel-management-system",
  "version": "1.0.0",
  "description": "Aurelia Hotel — full Hotel Management / Property Management System (public site, booking engine, admin PMS, guest & employee portals, Node/Express + Firebase backend).",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "server/server.js",
  "scripts": {
    "dev": "nodemon server/server.js",
    "start": "node server/server.js",
    "seed": "node database/seed.js",
    "generate-secret": "node scripts/generate-secret.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest --runInBand",
    "lint": "eslint server api",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
