{
  "id": "/",
  "name": "Aurelia Hotel Management",
  "short_name": "Aurelia PMS",
  "description": "Aurelia Hotel management system for the owner, managers and staff.",
  "start_url": "/launch.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FBF8F3",
  "theme_color": "#163A30",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "url": "/portal/messages.html"
    },
    {
      "name": "Notifications",
      "url": "/portal/notifications.html"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "prefer_related_applications": false,
  "categories": [
    "business",
    "productivity"
  ],
  "lang": "en"
}